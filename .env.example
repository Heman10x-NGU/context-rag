# Optional: explicit source roots. ContextRAG never scans your home directory.
RAG_VAULT_DIR=/absolute/path/to/markdown-notes
RAG_MEMORY_DIRS=/absolute/path/to/agent-memory:/absolute/path/to/another-memory-root

# Optional: enable hypothetical-document expansion. Requires qwen2.5:0.5b in Ollama.
RAG_ENABLE_HYDE=0
